ule / Electronic Brake Boost Controller hydraulic unit performance fault — internal hydraulic actuator does not respond as expected.",[["h","Hydraulic unit internal fault"]],["ABS warning light on","ESC/stability control deactivated","Possible reduced brake assist"],["hard",[500,3000]],"l"],"C0560":["Calibration Required","The chassis control module reports that a sensor or system calibration must be performed — for example after replacement of the steering angle, yaw rate or radar sensor. Affected functions remain disabled until calibration is completed.",[["h","Required calibration not performed after service"],["m","Calibration drive cycle incomplete"]],["ABS warning light on","ESC/stability control deactivated","Possible reduced brake assist"],["medium",[50,400]],"l"],"C0561":["ABS Disabled Warning Indicator Request","This code indicates that the ABS module has requested the ABS warning lamp to be illuminated because ABS function is disabled. It is typically logged together with the underlying root-cause code that disabled ABS.",[["h","Secondary code disabling ABS is present"],["m","Communication fault between ABS and cluster"]],["ABS warning light on","ESC/stability control deactivated","Possible reduced brake assist"],["medium",[50,800]],"l"],"C0562":["Brake Pedal Position Sensor Supply Voltage Circuit/Open","Open circuit on brake pedal position sensor supply voltage.",[["h","Supply wiring open"],["l","Pin pushed back out of connector body"],["l","Cracked solder joint inside the module or sensor"]],["ABS warning light on","ESC/stability control deactivated","Possible reduced brake assist"],["medium",[50,400]],"l"],"C0563":["Calibration Mismatch","The chassis control module has detected that stored calibration values do not match the current vehicle configuration — for example after a wheel/tire size change or replacement of an inertial sensor cluster. Stability functions are degraded.",[["h","Wheel size or sensor cluster mismatch"],["l","Stored calibration data corrupted"]],["ABS warning light on","ESC/stability control deactivated","Possible reduced brake assist"],["medium",[80,500]],"l"],"C0564":["ABS Control Module System Voltage Low","ABS control module system voltage below the safe operating range.",[["h","Weak battery or supply"]],["ABS warning light on","ESC/stability control deactivated","Possible reduced brake assist"],["easy",[80,500]],"l"],"C0565":["ABS Control Module System Voltage High","ABS control module system voltage above the safe operating range.",[["h","Alternator regulator failed"]],["ABS warning light on","ESC/stability control deactivated","Possible reduced brake assist"],["medium",[50,600]],"l"],"C0566":["Brake Booster Solenoid Circuit/Open","Open circuit on brake booster solenoid. Boost control tracks commanded vs.",[["h","Wiring break or coil open"],["l","Pin pushed back out of connector body"],["l","Cracked solder joint inside the module or sensor"]],["ABS warning light on","ESC/stability control deactivated","Possible reduced brake assist"],["medium",[150,1500]],"l"],"C0567":["Brake Booster Solenoid Circuit Low","Brake booster solenoid control voltage below expected range. Boost control tracks commanded vs.",[["h","Wiring shorted to ground"],["l","Connector pins corroded - high contact resistance"],["l","Harness chafing through insulation"]],["ABS warning light on","ESC/stability control deactivated","Possible reduced brake assist"],["medium",[150,1500]],"l"],"C0568":["Brake Booster Solenoid Circuit High","Brake booster solenoid control voltage above expected range. Boost control tracks commanded vs.",[["h","Wiring shorted to battery"],["l","Connector pins corroded - high contact resistance"],["l","Supply wire pinched against B+ source"]],["ABS warning light on","ESC/stability control deactivated","Possible reduced brake assist"],["medium",[150,1500]],"l"],"C0569":["Brake Booster Solenoid Circuit Performance","Brake booster solenoid does not respond mechanically as expected. Boost control trac