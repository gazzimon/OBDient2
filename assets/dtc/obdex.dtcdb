"h","Calibration not performed after replacement"]],["ABS warning light on","ESC/stability control deactivated","Possible reduced brake assist"],["medium",[80,500]],"l"],"C004D":["Brake System Pressure Slow Response","Brake system pressure response slower than expected.",[["h","Pump weak or hydraulic restriction"]],["ABS warning light on","ESC/stability control deactivated","Possible reduced brake assist"],["hard",[400,2500]],"l"],"C004E":["Brake System Pressure Control Valve Actuator Stuck","Brake system pressure control valve actuator stuck mechanically.",[["h","Valve stuck or coil failed"]],["ABS warning light on","ESC/stability control deactivated","Possible reduced brake assist"],["hard",[400,2500]],"l"],"C004F":["ABS Control Module Over Temperature","ABS control module exceeded its safe operating temperature.",[["h","Thermal overload from extended ABS use"]],["ABS warning light on","ESC/stability control deactivated","Possible reduced brake assist"],["medium",[200,1500]],"l"],"C0050":["Right Rear Wheel Speed Sensor Circuit Malfunction","The ABS control module has detected a fault in the right rear wheel speed sensor circuit. Loss of wheel speed information disables ABS and stability control, and a separate ABS warning lamp is illuminated.",[["h","Wheel speed sensor failed"],["m","Tone ring damaged or contaminated"],["m","Wiring break or chafe under chassis"],["l","Wheel hub bearing with integrated sensor ring failed"]],["ABS warning light on","ESC/stability control deactivated","Possible reduced brake assist"],["medium",[80,400]],"l"],"C0051":["Power Steering Position Sensor Performance","The chassis or power steering control module has detected that the steering position signal is implausible compared to vehicle motion. Stability control may be limited because correct yaw and slip-angle calculation depends on a valid steering angle.",[["h","Steering angle sensor not calibrated after alignment or repair"],["m","Steering angle sensor failed"],["l","Signal path through clock spring degraded"]],["ABS warning light on","ESC/stability control deactivated","Possible reduced brake assist"],["medium",[80,600]],"c"],"C0054":["Left Rear Wheel Speed Sensor Signal Erratic","Erratic pulses from the left rear wheel speed sensor. Wheel-speed signals feed ABS, ESC, traction control, transmission and odometer — a single dropped signal disables all of these safety functions until repaired.",[["h","Encoder ring contaminated"],["m","Tone ring cracked"],["l","Connector with intermittent contact under vibration"]],["ABS warning light on","ESC/stability control deactivated","Possible reduced brake assist"],["medium",[80,450]],"c"],"C0055":["Left Rear Wheel Speed Sensor No Signal","No pulses received from the left rear wheel speed sensor. Wheel-speed signals feed ABS, ESC, traction control, transmission and odometer — a single dropped signal disables all of these safety functions until repaired.",[["h","Sensor internally failed"],["m","Wiring open at suspension flex"]],["ABS warning light on","ESC/stability control deactivated","Possible reduced brake assist"],["medium",[80,400]],"c"],"C0056":["Left Rear Wheel Speed Sensor Circuit Intermittent","Intermittent open or short on the left rear wheel speed sensor circuit. Wheel-speed signals feed ABS, ESC, traction control, transmission and odometer — a single dropped signal disables all of these safety functions until repaired.",[["h","Connector unseated"],["m","Wire chafe"],["l","Connector with intermittent contact under vibration"]],["ABS warning light on","ESC/stability control deactivated","Possible reduced brake assist"],["medium",[60,300]],"l"],"C0060":["Right Rear Wheel Speed Sensor Circuit","The ABS control module detects a fault in the right rear wheel speed sensor circuit. ABS and stability control are deactivated.",[["h","Sensor failed"],["m","Wiring open"]],["ABS warning light on","ESC/stability control deactivated","Possible reduced brake assist"],["medium",[80,400]],"l"],"C0065":["Right Rear Wheel Speed Sensor No Signal","No pulses received from the right rear wheel speed sensor. Wheel-speed signals feed ABS, ESC, traction control, transmission and odometer — a single dropped signal disables all of these safety functions until repaired.",[["h","Sensor failed"],["m","Wiring open"]],["ABS warning light on","ESC/stability control deactivated","Possible reduced brake assist"],["medium",[80,400]],"l"],"C0066":["Right Rear Wheel Speed Sensor Circuit Intermittent","Intermittent open or short on the right rear wheel speed sensor circuit. Wheel-speed signals feed ABS, ESC, traction control, transmission and odometer — a single dropped signal disables all of these safety functions until repaired.",[["h","Connector unseated"],["m","Wire chafe"],["l","Connector with intermittent contact under vibration"]],["ABS warning light on","ESC/stability control deactivated","Possible reduced brake assist"],["medium",[60,300]],"l"],"C0069":["Yaw Rate/Longitude Sensors","Generic fault on yaw rate/longitudinal acceleration sensor cluster.",[["h","Sensor cluster failed"]],["ABS warning light on","ESC/stability control deactivated","Possible reduced brake assist"],["hard",[200,1500]],"c"],"C006A":["Multi-axis Acceleration Sensor","Generic fault on multi-axis acceleration sensor (combines lateral, longitudinal and vertical accelerations).",[["h","Sensor failed"]],["ABS warning light on","ESC/stability control deactivated","Possible reduced brake assist"],["hard",[200,1500]],"c"],"C006B":["Stability System Active Too Long","Electronic stability control intervened for an excessive duration.",[["h","Extended intervention from low traction or driver behavior"]],["ABS warning light on","ESC/stability control deactivated","Possible reduced brake assist"],["medium",[50,500]],"c"],"C006C":["Stability System","Generic fault in electronic stability control system.",[["h","ESC internal fault"]],["ABS warning light on","ESC/stability control deactivated","Possible reduced brake assist"],["hard",[400,2500]],"l"],"C0070":["Vehicle Speed Sensor Circuit","The chassis controller detects a fault in the dedicated vehicle speed sensor circuit (when present in addition to wheel speed sensors).",[["h","Sensor failed"],["m","Wiring open"]],["ABS warning light on","ESC/stability control deactivated","Possible reduced brake assist"],["medium",[80,350]],"l"],"C0071":["2/4 Wheel Drive Status Input","Fault on 2WD/4WD status signal input.",[["h","Switch or wiring fault"]],["ABS warning light on","ESC/stability control deactivated","Possible reduced brake assist"],["easy",[30,200]],"c"],"C0072":["Brake Temperature Too High","Brake temperature exceeded safe operating limit — risk of brake fade.",[["h","Hard or prolonged braking, mountain descent"]],["ABS warning light on","ESC/stability control deactivated","Possible reduced brake assist"],["easy",[0,200]],"c"],"C0073":["Delivered Driving Torque","Engine-delivered driving torque does not match TCS request.",[["h","ECM/TCS communication issue"]],["ABS warning light on","ESC/stability control deactivated","Possible reduced brake assist"],["medium",[100,800]],"c"],"C0074":["Requested Driving Torque","Driving torque request from TCS rejected or out of range.",[["h","ECM/TCS communication issue"]],["ABS warning light on","ESC/stability control deactivated","Possible reduced brake assist"],["medium",[100,800]],"c"],"C0076":["PWM for Traction Control","PWM communication signal for traction control faulty.",[["h","PWM signal fault"]],["ABS warning light on","ESC/stability control deactivated","Possible reduced brake assist"],["medium",[100,800]],"c"],"C0077":["Low Tire Pressure","Tire pressure monitoring system detected low tire pressure.",[["h","Tire(s) under-inflated"]],["ABS warning light on","ESC/stability control deactivated","Possible reduced brake assist"],["easy",[0,30]],"c"],"C0078":["Tire Diameter","Detected wheel speed implies tire diameter outside expected range — typically wrong tire size or mismatched tires.",[["h","Wrong tire size or mismatch"]],["ABS warning light on","ESC/stability control deactivated","Possible reduced brake assist"],["easy",[0,800]],"c"],"C0079":["Variable Effort Steering","Generic fault on variable effort steering (VES) system.",[["h","VES system fault"]],["ABS warning light on","ESC/stability control deactivated","Possible reduced brake assist"],["hard",[400,3000]],"c"],"C0080":["Wheel Speed Mismatch (Front Axle)","Front axle wheel speeds differ beyond the plausibility threshold over time. Often caused by mismatched tyre rolling circumference or a partially failing sensor.",[["h","Mixed tyre sizes or worn tyre on one side"],["m","One sensor drifting"]],["ABS warning light on","ESC/stability control deactivated","Possible reduced brake assist"],["easy",[0,400]],"l"],"C0082":["Brake System Malfunction Indicator","Brake system malfunction indicator circuit fault.",[["h","Lamp circuit or bulb fault"]],["ABS warning light on","ESC/stability control deactivated","Possible reduced brake assist"],["easy",[10,150]],"c"],"C0083":["Tire Pressure Monitor Malfunction Indicator","TPMS malfunction indicator circuit fault.",[["h","Lamp circuit or bulb fault"]],["ABS warning light on","ESC/stability control deactivated","Possible reduced brake assist"],["easy",[10,150]],"c"],"C0084":["Traction Active Indicator","Traction control active indicator lamp circuit fault.",[["h","Lamp circuit or bulb fault"]],["ABS warning light on","ESC/stability control deactivated","Possible reduced brake assist"],["easy",[10,150]],"c"],"C0085":["Traction Disable Indicator","Traction control disable indicator lamp circuit fault.",[["h","Lamp circuit or bulb fault"]],["ABS warning light on","ESC/stability control deactivated","Possible reduced brake assist"],["easy",[10,150]],"c"],"C0086":["Vehicle Dynamics Indicator","Vehicle dynamics control indicator lamp circuit fault.",[["h","Lamp circuit or bulb fault"]],["ABS warning light on","ESC/stability control deactivated","Possible reduced brake assist"],["easy",[10,150]],"c"],"C0089":["TCS Disable Switch","Fault on TCS disable switch.",[["h","Switch failed or wiring fault"]],["ABS warning light on","ESC/stability control deactivated","Possible reduced brake assist"],["easy",[30,200]],"c"],"C008A":["TCS Mode Control","Fault on TCS mode control input (offroad/sport mode etc.).",[["h","Mode switch fault"]],["ABS warning light on","ESC/stability control deactivated","Possible reduced brake assist"],["easy",[30,300]],"c"],"C0090":["Hydraulic Brake Pressure Sensor Circuit","The brake pressure sensor in the master cylinder or hydraulic block reports an implausible signal or no signal. The fault disables ABS, stability control and brake assist.",[["h","Pressure sensor element failed"],["m","Sensor wiring fault"]],["ABS warning light on","ESC/stability control deactivated","Possible reduced brake assist"],["hard",[200,900]],"l"],"C0091":["Hydraulic Brake Pressure Sensor Circuit Range/Performance","The brake pressure sensor signal is outside the plausibility band relative to pedal application. Wiring faults of this kind typically come from chafing, water ingress at connector seals, or pin push-back — a wiggle test on the harness while the code is active often confirms the location.",[["h","Sensor drift with age"],["l","Internal hydraulic block leak"],["l","Sensor element aged beyond calibration window"]],["ABS warning light on","ESC/stability control deactivated","Possible reduced brake assist"],["hard",[200,1100]],"l"],"C0092":["4WD/AWD Power Transfer Unit Position Sensor B","Fault on 4WD/AWD power transfer unit (PTU) position sensor B.",[["h","Sensor failed"]],["ABS warning light on","ESC/stability control deactivated","Possible reduced brake assist"],["hard",[200,1500]],"l"],"C0093":["4WD/AWD Power Transfer Unit Temperature Sensor","Fault on PTU temperature sensor.",[["h","Sensor failed"]],["ABS warning light on","ESC/stability control deactivated","Possible reduced brake assist"],["medium",[150,1000]],"l"],"C0094":["4WD/AWD Rear Differential Unit Temperature Sensor","Fault on rear differential unit temperature sensor.",[["h","Sensor failed"]],["ABS warning light on","ESC/stability control deactivated","Possible reduced brake assist"],["medium",[150,1000]],"l"],"C0095":["4WD/AWD Rear Differential Unit Actuator A","Fault on rear differential unit actuator A.",[["h","Actuator failed"]],["ABS warning light on","ESC/stability control deactivated","Possible reduced brake assist"],["hard",[400,2500]],"l"],"C0096":["4WD/AWD Rear Differential Unit Actuator A Data","Rear differential actuator A data implausible or out of range.",[["h","Actuator data fault"]],["ABS warning light on","ESC/stability control deactivated","Possible reduced brake assist"],["hard",[400,2500]],"l"],"C0097":["4WD/AWD Rear Differential Unit Actuator B","Fault on rear differential unit actuator B.",[["h","Actuator failed"]],["ABS warning light on","ESC/stability control deactivated","Possible reduced brake assist"],["hard",[400,2500]],"l"],"C0098":["4WD/AWD Rear Differential Unit Actuator B Data","Rear differential actuator B data implausible or out of range.",[["h","Actuator data fault"]],["ABS warning light on","ESC/stability control deactivated","Possible reduced brake assist"],["hard",[400,2500]],"l"],"C0099":["ABS Control Module Internal Fault","The ABS control module fails its internal self-test (RAM, ROM or processor watchdog). ABS and stability control are disabled.",[["h","Module internally failed"],["m","Power supply undervoltage during operation"]],["ABS warning light on","ESC/stability control deactivated","Possible reduced brake assist"],["hard",[400,1600]],"l"],"C009A":["4WD/AWD Rear Differential Unit Actuator A Position Sensor B","Fault on rear differential actuator A position sensor B.",[["h","Sensor failed"]],["ABS warning light on","ESC/stability control deactivated","Possible reduced brake assist"],["hard",[200,1500]],"l"],"C009B":["4WD/AWD Rear Differential Unit Actuator A Position Sensor C","Fault on rear differential actuator A position sensor C.",[["h","Sensor failed"]],["ABS warning light on","ESC/stability control deactivated","Possible reduced brake assist"],["hard",[200,1500]],"l"],"C009C":["4WD/AWD Rear Differential Unit Actuator A Position Sensor Correlation","Position sensors on rear differential actuator A disagree.",[["h","One sensor drifted"]],["ABS warning light on","ESC/stability control deactivated","Possible reduced brake assist"],["hard",[200,1500]],"l"],"C009D":["4WD/AWD Rear Differential Unit Actuator B Position Sensor A","Fault on rear differential actuator B position sensor A.",[["h","Sensor failed"]],["ABS warning light on","ESC/stability control deactivated","Possible reduced brake assist"],["hard",[200,1500]],"l"],"C009E":["4WD/AWD Rear Differential Unit Actuator B Position Sensor B","Fault on rear differential actuator B position sensor B.",[["h","Sensor failed"]],["ABS warning light on","ESC/stability control deactivated","Possible reduced brake assist"],["hard",[200,1500]],"l"],"C009F":["4WD/AWD Rear Differential Unit Actuator B Position Sensor C","Fault on rear differential actuator B position sensor C.",[["h","Sensor failed"]],["ABS warning light on","ESC/stability control deactivated","Possible reduced brake assist"],["hard",[200,1500]],"l"],"C00A0":["4WD/AWD Rear Differential Unit Actuator B Position Sensor Correlation","Position sensors on rear differential actuator B disagree.",[["h","One sensor drifted"]],["ABS warning light on","ESC/stability control deactivated","Possible reduced brake assist"],["hard",[200,1500]],"l"],"C00A1":["Driveline Control Module","Generic fault on driveline control module.",[["h","Module internal fault"]],["ABS warning light on","ESC/stability control deactivated","Possible reduced brake assist"],["hard",[400,3000]],"l"],"C00A2":["Driveline Control Module Power Transfer Unit Control Circuit Driver","Fault on driveline control module driver for PTU control circuit.",[["h","Internal driver fault"]],["ABS warning light on","ESC/stability control deactivated","Possible reduced brake assist"],["hard",[400,3000]],"l"],"C00A3":["Driveline Control Module Rear Differential Unit A Control Circuit Driver","Fault on driveline control module driver for rear differential unit A.",[["h","Internal driver fault"]],["ABS warning light on","ESC/stability control deactivated","Possible reduced brake assist"],["hard",[400,3000]],"l"],"C00A4":["Driveline Control Module Rear Differential Unit B Control Circuit Driver","Fault on driveline control module driver for rear differential unit B.",[["h","Internal driver fault"]],["ABS warning light on","ESC/stability control deactivated","Possible reduced brake assist"],["hard",[400,3000]],"l"],"C00A5":["Driveline Control Module Transfer Case Unit Control Circuit Driver","Fault on driveline control module driver for transfer case unit.",[["h","Internal driver fault"]],["ABS warning light on","ESC/stability control deactivated","Possible reduced brake assist"],["hard",[400,3000]],"l"],"C00A6":["4WD/AWD Transfer Case Unit Actuator","Fault on transfer case unit actuator.",[["h","Actuator failed"]],["ABS warning light on","ESC/stability control deactivated","Possible reduced brake assist"],["hard",[400,2500]],"l"],"C00A7":["4WD/AWD Transfer Case Unit Actuator Position Sensor A","Fault on transfer case actuator position sensor A.",[["h","Sensor failed"]],["ABS warning light on","ESC/stability control deactivated","Possible reduced brake assist"],["hard",[200,1500]],"l"],"C00A8":["4WD/AWD Transfer Case Unit Actuator Position Sensor B","Fault on transfer case actuator position sensor B.",[["h","Sensor failed"]],["ABS warning light on","ESC/stability control deactivated","Possible reduced brake assist"],["hard",[200,1500]],"l"],"C0110":["ABS Pump Motor Circuit Malfunction","The ABS control module has detected a fault in the hydraulic pump motor circuit. The pump rebuilds brake pressure during ABS regulation — without it, ABS and stability control are disabled.",[["h","ABS pump motor failed (worn brushes, seized)"],["m","ABS pump relay failed"],["l","Power supply wiring or fuse fault"]],["ABS warning light on","ESC/stability control deactivated","Possible reduced brake assist"],["hard",[300,1500]],"l"],"C0111":["ABS Activation Excessively Long","ABS regulation has been active longer than the allowed duration during a single brake event, suggesting a sensor or hydraulic problem.",[["m","Extreme low-friction road condition"],["m","Hydraulic block internal leak"]],["ABS warning light on","ESC/stability control deactivated","Possible reduced brake assist"],["hard",[200,1400]],"l"],"C0112":["ABS Activation Frequency Too High","ABS regulation cycles activate more frequently than the plausibility model allows.",[["h","Wheel speed sensor signal noise"],["m","Tone ring damaged"]],["ABS warning light on","ESC/stability control deactivated","Possible reduced brake assist"],["medium",[80,600]],"l"],"C0121":["Valve Relay Circuit Malfunction","The ABS control module has detected a fault in the valve relay circuit, which supplies power to the ABS solenoid valves. With this fault, the module cannot energize the valves and ABS is disabled.",[["h","Valve relay failed"],["m","Internal ABS module fault (relay integrated)"],["l","Power supply wiring or fuse fault"]],["ABS warning light on","ESC/stability control deactivated","Possible reduced brake assist"],["hard",[200,1200]],"l"],"C0128":["Low Brake Fluid Indicated","The brake fluid level switch in the master cylinder reservoir reports a low level. ABS and stability control may be deactivated as a precaution.",[["h","Worn brake pads (fluid drops as pistons extend)"],["m","Hydraulic system leak"],["l","Level switch failed"]],["ABS warning light on","ESC/stability control deactivated","Possible reduced brake assist"],["easy",[10,400]],"l"],"C0131":["Master Cylinder Pressure Sensor Range/Performance","The ABS or stability control module has detected an implausible signal from the master cylinder brake pressure sensor. This sensor reports driver brake input and is used by ABS and ESP for control decisions.",[["h","Pressure sensor failed"],["m","Wiring or connector fault"],["l","Air in brake system causing erratic pressure"]],["ABS warning light on","ESC/stability control deactivated","Possible reduced brake assist"],["medium",[150,700]],"l"],"C0136":["Stop Lamp Switch Circuit","The ABS or stability control module sees an implausible brake light switch signal. Stability and brake assist functions can be limited until the fault is cleared.",[["h","Brake light switch failed"],["m","Switch misadjusted on pedal bracket"]],["ABS warning light on","ESC/stability control deactivated","Possible reduced brake assist"],["easy",[20,150]],"l"],"C0141":["Left Front ABS Inlet Solenoid Circuit","Left Front ABS Inlet Solenoid Circuit: an electrical fault is present in the circuit.",[["h","Inlet solenoid coil open or shorted"],["m","Internal ABS module fault"]],["ABS warning light on","ESC/stability control deactivated","Possible reduced brake assist"],["hard",[300,1500]],"l"],"C0146":["Left Front ABS Outlet Solenoid Circuit","Left Front ABS Outlet Solenoid Circuit: an electrical fault is present in the circuit.",[["h","Outlet solenoid coil open or shorted"],["m","Internal ABS module fault"]],["ABS warning light on","ESC/stability control deactivated","Possible reduced brake assist"],["hard",[300,1500]],"l"],"C0148":["Right Front ABS Outlet Solenoid B Circuit Malfunction","The ABS module has detected an electrical fault in the secondary outlet solenoid for the right front wheel. ABS and stability control are disabled while the fault is active.",[["h","Outlet solenoid valve failed (open or shorted)"],["m","Internal fault in ABS hydraulic unit"]],["ABS warning light on","ESC/stability control deactivated","Possible reduced brake assist"],["hard",[400,1500]],"l"],"C0151":["Right Front ABS Inlet Solenoid Circuit","Right Front ABS Inlet Solenoid Circuit: an electrical fault is present in the circuit.",[["h","Inlet solenoid coil open or shorted"],["m","Internal ABS module fault"]],["ABS warning light on","ESC/stability control deactivated","Possible reduced brake assist"],["hard",[300,1500]],"l"],"C0153":["Right Front ABS Inlet Solenoid B Circuit Malfunction","Electrical fault in the secondary inlet solenoid for the right front wheel. Pressure modulation for that wheel is no longer possible and ABS is disabled.",[["h","Inlet solenoid valve failed"],["m","Internal hydraulic unit fault"]],["ABS warning light on","ESC/stability control deactivated","Possible reduced brake assist"],["hard",[400,1500]],"l"],"C0156":["Right Front ABS Outlet Solenoid Circuit","Right Front ABS Outlet Solenoid Circuit: an electrical fault is present in the circuit.",[["h","Outlet solenoid coil open or shorted"],["m","Internal ABS module fault"]],["ABS warning light on","ESC/stability control deactivated","Possible reduced brake assist"],["hard",[300,1500]],"l"],"C0158":["Left Rear ABS Inlet Solenoid Circuit Malfunction","Electrical fault in the inlet solenoid for the left rear wheel. ABS is disabled and the warning lamp is illuminated.",[["h","Inlet solenoid valve failed"],["m","Internal hydraulic unit fault"]],["ABS warning light on","ESC/stability control deactivated","Possible reduced brake assist"],["hard",[400,1500]],"l"],"C0161":["ABS/TCS Brake Switch Circuit","The ABS or traction control module has detected an implausible signal from the brake light switch. The switch tells the module whether the driver is braking and is used to inhibit traction control during braking.",[["h","Brake light switch failed or misadjusted"],["m","Wiring or connector fault"]],["ABS warning light on","ESC/stability control deactivated","Possible reduced brake assist"],["easy",[30,200]],"l"],"C0163":["Left Rear ABS Outlet Solenoid Circuit Malfunction","Electrical fault in the outlet solenoid for the left rear wheel. ABS pressure release for this wheel is no longer possible.",[["h","Outlet solenoid valve failed"],["m","Internal hydraulic unit fault"]],["ABS warning light on","ESC/stability control deactivated","Possible reduced brake assist"],["hard",[400,1500]],"l"],"C0168":["Right Rear ABS Inlet Solenoid Circuit Malfunction","Electrical fault in the inlet solenoid for the right rear wheel. ABS is disabled while the fault is active.",[["h","Inlet solenoid valve failed"],["m","Internal hydraulic unit fault"]],["ABS warning light on","ESC/stability control deactivated","Possible reduced brake assist"],["hard",[400,1500]],"l"],"C0173":["Right Rear ABS Outlet Solenoid Circuit Malfunction","Electrical fault in the outlet solenoid for the right rear wheel. ABS pressure release for this wheel is no longer possible.",[["h","Outlet solenoid valve failed"],["m","Internal hydraulic unit fault"]],["ABS warning light on","ESC/stability control deactivated","Possible reduced brake assist"],["hard",[400,1500]],"l"],"C0185":["Lateral Acceleration Sensor Range/Performance","The stability control module has detected that the lateral acceleration sensor signal is out of the expected range or does not match other inertial sensors. ESP and roll-stability functions may be disabled.",[["h","Lateral acceleration sensor failed or drifted"],["m","Sensor mounting loose or misaligned after body repair"],["m","Calibration after replacement not performed"]],["ABS warning light on","ESC/stability control deactivated","Possible reduced brake assist"],["medium",[150,800]],"l"],"C0186":["Lateral Acceleration Sensor Circuit","The stability control module has detected an implausible signal from the lateral acceleration sensor. ESP uses lateral g-force together with yaw rate and steering angle to detect skid conditions — without it, ESP is disabled.",[["h","Lateral acceleration sensor failed"],["m","Sensor cluster loose or mounted incorrectly"],["l","Wiring or connector fault"]],["ABS warning light on","ESC/stability control deactivated","Possible reduced brake assist"],["medium",[150,700]],"l"],"C0196":["Yaw Rate Sensor Circuit","The stability control module has detected an implausible signal from the yaw rate sensor. The yaw sensor measures rotation around the vertical axis and is essential for ESP — a fault disables stability control.",[["h","Yaw rate sensor failed"],["m","Sensor not calibrated after replacement or alignment"],["l","Wiring or connector fault"]],["ABS warning light on","ESC/stability control deactivated","Possible reduced brake assist"],["medium",[200,900]],"l"],"C0200":["ABS Solenoid Valve Front Left Circuit","The ABS control module detects a fault in the inlet/outlet solenoid for the front left brake circuit. The valve is integrated in the hydraulic block; replacement is generally a workshop task.",[["h","Solenoid coil open"],["m","Internal short to ground in valve block"]],["ABS warning light on","ESC/stability control deactivated","Possible reduced brake assist"],["hard",[400,1600]],"l"],"C0201":["Brake Fluid Level Switch Circuit","The ABS or brake control module has detected a fault in the brake fluid level switch circuit. A low fluid level indicates a potential leak in the hydraulic system and disables ABS while a separate brake warning lamp is illuminated.",[["h","Brake fluid level low (worn pads or hydraulic leak)"],["m","Float switch in reservoir failed"],["l","Wiring or connector fault"]],["ABS warning light on","ESC/stability control deactivated","Possible reduced brake assist"],["easy",[40,300]],"l"],"C0202":["Brake Pedal Position Sensor","The chassis or brake control module has detected an implausible signal from the brake pedal position sensor. Modern brake systems use this sensor for brake assist, regenerative braking and adaptive cruise control functions.",[["h","Pedal position sensor failed"],["m","Sensor not calibrated after replacement"],["l","Wiring or connector fault"]],["ABS warning light on","ESC/stability control deactivated","Possible reduced brake assist"],["medium",[100,600]],"l"],"C0203":["ABS Solenoid Valve Front Right Circuit","Fault in the front right ABS solenoid (mirror of C0200).",[["h","Solenoid coil open"],["m","Internal short to ground"]],["ABS warning light on","ESC/stability control deactivated","Possible reduced brake assist"],["hard",[400,1600]],"l"],"C0205":["Stop Lamp Switch Circuit","The ABS or stability control module has detected a fault in the stop lamp switch circuit. The brake light switch tells the module whether the driver is braking and is used to coordinate ABS, traction control and cruise control.",[["h","Stop lamp switch failed or misadjusted"],["m","Wiring or connector fault"],["l","Blown stop lamp fuse"]],["ABS warning light on","ESC/stability control deactivated","Possible reduced brake assist"],["easy",[30,200]],"l"],"C0206":["ABS Solenoid Valve Rear Left Circuit","Fault in the rear left ABS solenoid valve.",[["h","Solenoid coil open"],["m","Internal short to ground"]],["ABS warning light on","ESC/stability control deactivated","Possible reduced brake assist"],["hard",[400,1600]],"l"],"C0209":["ABS Solenoid Valve Rear Right Circuit","Fault in the rear right ABS solenoid valve.",[["h","Solenoid coil open"],["m","Internal short to ground"]],["ABS warning light on","ESC/stability control deactivated","Possible reduced brake assist"],["hard",[400,1600]],"l"],"C0220":["ABS Valve Block Supply Voltage","Supply voltage to the ABS valve block is out of range, disabling all valve control.",[["h","Battery undervoltage"],["m","Ground point corroded"]],["ABS warning light on","ESC/stability control deactivated","Possible reduced brake assist"],["medium",[80,600]],"l"],"C0225":["ABS Valve Relay Circuit","The valve relay supplying the ABS solenoids does not respond as commanded.",[["h","Valve relay failed"],["m","Relay control circuit open"]],["ABS warning light on","ESC/stability control deactivated","Possible reduced brake assist"],["medium",[80,500]],"l"],"C0230":["Brake Pedal Position Sensor Circuit","The brake pedal position sensor reports an implausible signal. Required for brake-by-wire and stability control.",[["h","Sensor failed"],["m","Pedal linkage loose, biasing sensor"]],["ABS warning light on","ESC/stability control deactivated","Possible reduced brake assist"],["medium",[80,350]],"l"],"C0234":["Wheel Speed Sensor Frequency Error","The ABS control module has detected that one of the wheel speed sensor signals has a frequency outside the plausible range, e.g. unrealistically high pulses or signal dropouts at speed.",[["h","Tone ring damaged, missing teeth, or contaminated"],["m","Sensor air gap incorrect (loose mounting)"],["l","Wheel speed sensor degraded"]],["ABS warning light on","ESC/stability control deactivated","Possible reduced brake assist"],["medium",[80,400]],"l"],"C0235":["Wheel Speed Sensor Signal Erratic","The ABS control module has detected an erratic wheel speed sensor signal — sudden jumps or dropouts compared to the other wheels. Typical causes are a damaged tone ring or a loose sensor.",[["h","Tone ring damaged or contaminated with metal debris"],["m","Wheel speed sensor loose in housing"],["l","Excessive hub bearing play"]],["ABS warning light on","ESC/stability control deactivated","Possible reduced brake assist"],["medium",[80,500]],"l"],"C0237":["Loss of Speed Sensor Signal Front Left","The ABS control module has lost the wheel speed signal from the front left wheel during driving. ABS and stability control are disabled because wheel-individual speed information is required for slip detection.",[["h","Wheel speed sensor failed"],["m","Wiring break at wheel arch"],["l","Tone ring damaged"]],["ABS warning light on","ESC/stability control deactivated","Possible reduced brake assist"],["medium",[80,400]],"l"],"C0238":["Speed Wheel-to-Wheel Mismatch","The ABS control module has detected an implausible speed difference between wheels that cannot be explained by cornering. This typically points to one suspect sensor, mismatched tyre sizes or a damaged tone ring.",[["h","Tyre sizes or wear levels do not match across axles"],["m","Tone ring missing teeth on one wheel"],["l","Wheel speed sensor degraded"]],["ABS warning light on","ESC/stability control deactivated","Possible reduced brake assist"],["medium",[80,600]],"l"],"C0240":["Brake Pressure Sensor","The ABS or stability control module has detected a fault in a brake pressure sensor. Pressure information is used by ESP and brake assist to determine driver intent and modulation pressure during regulation.",[["h","Brake pressure sensor failed"],["m","Wiring or connector fault"],["l","Air in brake system"]],["ABS warning light on","ESC/stability control deactivated","Possible reduced brake assist"],["medium",[150,800]],"l"],"C0241":["ABS Warning Lamp Control Circuit","The ABS warning lamp control circuit is shorted or open. The driver may see a permanently lit or non-functional ABS warning lamp.",[["m","Lamp bulb/LED failed"],["m","Control wiring shorted"]],["ABS warning light on","ESC/stability control deactivated","Possible reduced brake assist"],["medium",[40,350]],"l"],"C0242":["PCM Indicated ABS Malfunction","The powertrain control module reports a fault that the ABS module must consider (e.g. traction control engine torque request fault).",[["h","Traction control torque request fault"],["m","Bus communication loss"]],["ABS warning light on","ESC/stability control deactivated","Possible reduced brake assist"],["medium",[80,600]],"l"],"C0244":["PWM Brake Pressure Modulation Circuit","The PWM control of the brake pressure modulation valves is faulty.",[["h","Module PWM output stage fault"]],["ABS warning light on","ESC/stability control deactivated","Possible reduced brake assist"],["hard",[400,1600]],"l"],"C0245":["Wheel Speed Sensor Frequency Mismatch","The ABS control module has detected that the frequency of one wheel speed sensor signal does not match the others under stable driving conditions. This often indicates a tone ring with extra or missing teeth or a sensor with degraded signal quality.",[["h","Tone ring damaged or contaminated"],["m","Wheel speed sensor degraded"],["l","Tyre size mismatch"]],["ABS warning light on","ESC/stability control deactivated","Possible reduced brake assist"],["medium",[80,500]],"l"],"C0246":["ABS/TCS Control Module Internal Performance","Internal plausibility check of the combined ABS/TCS control module fails.",[["h","Module internal fault"]],["ABS warning light on","ESC/stability control deactivated","Possible reduced brake assist"],["hard",[400,1600]],"l"],"C0250":["Power Steering Pump Pressure","The power steering control module has detected an implausible pressure or load signal from the steering pump. On hydraulic systems this may indicate low fluid or a worn pump; on electric systems it may indicate excessive motor load.",[["h","Power steering fluid low or contaminated"],["m","Power steering pump worn"],["l","Pressure sensor failed"]],["ABS warning light on","ESC/stability control deactivated","Possible reduced brake assist"],["medium",[100,1200]],"l"],"C0252":["Pump Motor Ground Circuit Open","The pump motor ground return is open. The motor cannot run, and the system disables ABS and stability control.",[["h","Ground strap corroded"],["m","Ground wire broken"],["l","Pin pushed back out of connector body"]],["ABS warning light on","ESC/stability control deactivated","Possible reduced brake assist"],["medium",[40,250]],"l"],"C0258":["Brake Booster Vacuum Sensor Circuit","The brake booster vacuum sensor reports an implausible signal; brake assist functions are reduced. Boost control tracks commanded vs.",[["h","Vacuum hose leak"],["m","Sensor failed"]],["ABS warning light on","ESC/stability control deactivated","Possible reduced brake assist"],["medium",[60,400]],"l"],"C0265":["EBCM Relay Circuit","The Electronic Brake Control Module has detected a fault in its main supply relay circuit. Without proper relay supply the EBCM cannot operate the hydraulic unit and ABS as well as stability control are disabled.",[["h","EBCM relay failed"],["m","Internal EBCM fault (relay integrated)"],["l","Power supply wiring or fuse fault"]],["ABS warning light on","ESC/stability control deactivated","Possible reduced brake assist"],["hard",[200,1500]],"l"],"C0266":["Active Brake Booster","The brake control module has detected a fault in the active (electric or vacuum-controlled) brake booster. Active boosters are used by emergency brake assist and adaptive cruise control to autonomously build brake pressure.",[["h","Active booster motor or solenoid failed"],["m","Vacuum supply weak (vacuum pump or hose fault)"],["l","Wiring or connector fault"]],["ABS warning light on","ESC/stability control deactivated","Possible reduced brake assist"],["hard",[400,2500]],"l"],"C0267":["Brake Pump Motor Circuit","The ABS or brake control module has detected an electrical fault in the brake pump motor circuit. The pump is used to build brake pressure during ABS, ESP and brake-by-wire operations and a fault disables these functions.",[["h","Brake pump motor failed"],["m","Pump motor relay failed"],["l","Power supply wiring fault"]],["ABS warning light on","ESC/stability control deactivated","Possible reduced brake assist"],["hard",[300,1500]],"l"],"C0268":["Brake Pump Run Time Exceeded","The brake control module has detected that the brake pump has run longer than the allowed maximum time. This typically indicates the pump cannot reach target pressure due to a hydraulic leak, air in the system or a worn pump.",[["h","Hydraulic leak in brake system"],["m","Air in brake system"],["l","Brake pump worn or weak"]],["ABS warning light on","ESC/stability control deactivated","Possible reduced brake assist"],["hard",[200,1500]],"l"],"C0269":["Brake Vacuum Sensor","The brake control module has detected an implausible signal from the vacuum sensor on the brake booster. Modern systems monitor booster vacuum to ensure brake assist is available, especially with stop-start engines and electric vacuum pumps.",[["h","Vacuum sensor failed"],["m","Leak in vacuum supply line"],["l","Vacuum pump weak"]],["ABS warning light on","ESC/stability control deactivated","Possible reduced brake assist"],["medium",[100,800]],"l"],"C0273":["Brake Booster Pressure Sensor Circuit Malfunction","The brake control module has detected an out-of-range or implausible signal from the brake booster pressure sensor. Brake assist and electronic boost functions may be limited.",[["h","Booster pressure sensor failed"],["m","Wiring or connector fault to sensor"]],["ABS warning light on","ESC/stability control deactivated","Possible reduced brake assist"],["medium",[150,700]],"l"],"C0277":["Brake Booster Vacuum Sensor Circuit Malfunction","The brake control module has detected an implausible signal from the booster vacuum sensor. Loss of vacuum signal can cause hard pedal and reduced power assist.",[["h","Vacuum sensor failed"],["m","Vacuum leak in booster or hose"]],["ABS warning light on","ESC/stability control deactivated","Possible reduced brake assist"],["medium",[80,500]],"l"],"C0279":["Brake Booster Boost Sensor Circuit Malfunction","The brake control module has detected an electrical fault in the booster boost (assist pressure) sensor circuit. Power-assist regulation may default to a backup strategy.",[["h","Boost sensor failed"],["m","Sensor wiring or connector fault"]],["ABS warning light on","ESC/stability control deactivated","Possible reduced brake assist"],["medium",[150,700]],"l"],"C0287":["ESP Performance","The stability control module has detected that overall ESP performance is degraded — typically a plausibility check between yaw rate, lateral acceleration, steering angle and wheel speeds has failed. ESP is deactivated until the root cause is resolved.",[["h","Sensor calibration required after repair"],["m","Sensor cluster loose or mounted incorrectly"],["l","Secondary fault on individual sensor"]],["ABS warning light on","ESC/stability control deactivated","Possible reduced brake assist"],["medium",[80,1000]],"l"],"C0288":["Yaw Rate Sensor Range","The stability control module has detected that the yaw rate sensor signal is outside the plausible range during stable driving. This typically indicates a sensor offset, an incorrect mounting or a degraded sensor element.",[["h","Sensor not calibrated"],["m","Yaw rate sensor failed"],["l","Sensor cluster mounted incorrectly"]],["ABS warning light on","ESC/stability control deactivated","Possible reduced brake assist"],["medium",[200,900]],"l"],"C0290":["Brake Pedal Stroke Sensor Circuit Malfunction","The brake control module has detected an out-of-range signal from the brake pedal stroke sensor. Pedal travel information is required for brake assist and electronically boosted braking.",[["h","Pedal stroke sensor failed"],["m","Sensor mounting or pedal linkage misadjusted"]],["ABS warning light on","ESC/stability control deactivated","Possible reduced brake assist"],["medium",[120,600]],"l"],"C0291":["Brake Pedal Apply Sensor Circuit Malfunction","Electrical fault in the brake pedal apply sensor circuit. The module cannot reliably detect whether the brake pedal is pressed, which affects ABS, ESP and brake assist functions.",[["h","Pedal apply sensor failed"],["m","Wiring or connector fault"]],["ABS warning light on","ESC/stability control deactivated","Possible reduced brake assist"],["medium",[100,500]],"l"],"C0295":["Steering Sensor Indicates Bias","The stability control module has detected that the steering wheel position sensor reports a non-zero angle when the vehicle is driving straight. This bias makes ESP intervene incorrectly and the system requires recalibration.",[["h","Steering angle sensor calibration required"],["m","Wheel alignment incorrect"],["l","Steering angle sensor failed"]],["ABS warning light on","ESC/stability control deactivated","Possible reduced brake assist"],["medium",[60,600]],"l"],"C0300":["Inlet Valve Front Left Performance","The front left inlet solenoid valve does not respond hydraulically as expected during ABS self-test.",[["h","Valve stuck due to brake fluid debris"],["m","Coil resistance drift"]],["ABS warning light on","ESC/stability control deactivated","Possible reduced brake assist"],["hard",[400,1600]],"l"],"C0301":["Air Suspension Compressor Relay","The air suspension control module has detected a fault in the compressor relay circuit. The compressor cannot be energized which prevents the system from refilling the air struts and ride height drops over time.",[["h","Compressor relay failed"],["m","Relay wiring or fuse fault"],["l","Internal module fault"]],["ABS warning light on","ESC/stability control deactivated","Possible reduced brake assist"],["medium",[60,500]],"l"],"C0302":["Outlet Valve Front Left Performance","The front left outlet solenoid valve does not respond hydraulically as expected.",[["h","Valve stuck"],["m","Coil resistance drift"]],["ABS warning light on","ESC/stability control deactivated","Possible reduced brake assist"],["hard",[400,1600]],"l"],"C0303":["Inlet Valve Front Right Performance","The front right inlet solenoid valve does not respond hydraulically as expected.",[["h","Valve stuck"],["m","Coil resistance drift"]],["ABS warning light on","ESC/stability control deactivated","Possible reduced brake assist"],["hard",[400,1600]],"l"],"C0304":["Outlet Valve Front Right Performance","The front right outlet solenoid valve does not respond hydraulically as expected.",[["h","Valve stuck"],["m","Coil resistance drift"]],["ABS warning light on","ESC/stability control deactivated","Possible reduced brake assist"],["hard",[400,1600]],"l"],"C0305":["Inlet Valve Rear Left Performance","The rear left inlet solenoid valve does not respond hydraulically as expected.",[["h","Valve stuck"],["m","Coil resistance drift"]],["ABS warning light on","ESC/stability control deactivated","Possible reduced brake assist"],["hard",[400,1600]],"l"],"C0306":["Ride Height Sensor Front Left","Ride Height Sensor Front Left: the control module has detected this fault condition. Without this signal the suspension control module cannot self-level the vehicle.",[["h","Ride height sensor failed"],["m","Sensor linkage broken or detached"],["l","Wiring or connector fault"]],["ABS warning light on","ESC/stability control deactivated","Possible reduced brake assist"],["medium",[80,500]],"l"],"C0307":["Inlet Valve Rear Right Performance","The rear right inlet solenoid valve does not respond hydraulically as expected.",[["h","Valve stuck"],["m","Coil resistance drift"]],["ABS warning light on","ESC/stability control deactivated","Possible reduced brake assist"],["hard",[400,1600]],"l"],"C0308":["Ride Height Sensor Front Right","Ride Height Sensor Front Right: the control module has detected this fault condition. Without this signal the suspension control module cannot self-level the vehicle.",[["h","Ride height sensor failed"],["m","Sensor linkage broken or detached"],["l","Wiring or connector fault"]],["ABS warning light on","ESC/stability control deactivated","Possible reduced brake assist"],["medium",[80,500]],"l"],"C0309":["Outlet Valve Rear Right Performance","The rear right outlet solenoid valve does not respond hydraulically as expected.",[["h","Valve stuck"],["m","Coil resistance drift"]],["ABS warning light on","ESC/stability control deactivated","Possible reduced brake assist"],["hard",[400,1600]],"l"],"C0310":["Ride Height Sensor Rear Left","Ride Height Sensor Rear Left: the control module has detected this fault condition. Without this signal the suspension control module cannot self-level the vehicle.",[["h","Ride height sensor failed"],["m","Sensor linkage broken or detached"],["l","Wiring or connector fault"]],["ABS warning light on","ESC/stability control deactivated","Possible reduced brake assist"],["medium",[80,500]],"l"],"C0312":["Ride Height Sensor Rear Right","Ride Height Sensor Rear Right: the control module has detected this fault condition. Without this signal the suspension control module cannot self-level the vehicle.",[["h","Ride height sensor failed"],["m","Sensor linkage broken or detached"],["l","Wiring or connector fault"]],["ABS warning light on","ESC/stability control deactivated","Possible reduced brake assist"],["medium",[80,500]],"l"],"C0317":["Compressor Relay Circuit","The air suspension control module has detected a circuit fault on the compressor relay output — typically open circuit, short to ground or short to power. Self-levelling is disabled and the vehicle may sit lower than normal.",[["h","Compressor relay failed (stuck or open)"],["m","Compressor motor shorted, dragging supply down"],["l","Relay wiring or connector fault"]],["ABS warning light on","ESC/stability control deactivated","Possible reduced brake assist"],["medium",[80,700]],"l"],"C0327":["Encoder Motor","The transfer case control module has detected a fault in the encoder motor used to shift between 2WD and 4WD ranges. A fault prevents range changes and may leave the transfer case in an undefined position.",[["h","Encoder motor failed (worn brushes or seized)"],["m","Wiring or connector fault"],["l","Internal control module fault"]],["ABS warning light on","ESC/stability control deactivated","Possible reduced brake assist"],["hard",[300,1500]],"l"],"C0374":["4WD Drive Coupling","The 4WD or AWD control module has detected a fault on the electronic drive coupling that distributes torque between axles. Reduced torque transfer or a complete loss of all-wheel drive function may result.",[["h","Coupling actuator failed"],["m","Coupling oil overheated"],["l","Wiring or connector fault"]],["ABS warning light on","ESC/stability control deactivated","Possible reduced brake assist"],["hard",[400,3000]],"l"],"C0376":["Front Axle Disconnect","The 4WD control module has detected a fault on the front axle disconnect actuator. On part-time AWD vehicles this actuator decouples the front axle for fuel saving, and a fault prevents engagement or disengagement of front-wheel drive.",[["h","Disconnect actuator failed (motor or solenoid)"],["m","Wiring or connector fault"],["l","Axle position switch failed"]],["ABS warning light on","ESC/stability control deactivated","Possible reduced brake assist"],["hard",[300,1500]],"l"],"C0387":["Transfer Case Position Sensor","The transfer case control module has detected an implausible signal from the position sensor that reports the current shift position (2HI, 4HI, 4LO, neutral). Without a valid position the system cannot complete a range change.",[["h","Transfer case position sensor failed"],["m","Wiring or connector fault"],["l","Encoder motor stuck between positions"]],["ABS warning light on","ESC/stability control deactivated","Possible reduced brake assist"],["hard",[200,1200]],"l"],"C0388":["Transfer Case High Range Switch Circuit Malfunction","The transfer case control module has detected an implausible state from the high range (4H) position switch. Range selection in 4WD mode may be limited.",[["h","High range position switch failed"],["m","Shift actuator out of position"]],["ABS warning light on","ESC/stability control deactivated","Possible reduced brake assist"],["medium",[150,800]],"l"],"C0389":["Transfer Case Low Range Switch Circuit Malfunction","The transfer case control module has detected an implausible state from the low range (4L) position switch. Engagement of low range may be inhibited.",[["h","Low range position switch failed"],["m","Shift actuator out of position"]],["ABS warning light on","ESC/stability control deactivated","Possible reduced brake assist"],["medium",[150,800]],"l"],"C0399":["4WD Mode Switch Circuit Malfunction","The transfer case or 4WD control module has detected an invalid signal from the driver-operated 4WD mode selector. Mode requests from the dashboard may be ignored.",[["h","Mode selector switch failed"],["m","Wiring or connector fault"]],["ABS warning light on","ESC/stability control deactivated","Possible reduced brake assist"],["easy",[60,300]],"l"],"C0400":["Traction Control Solenoid Valve Circuit","The dedicated traction control isolation valve in the hydraulic block reports an electrical fault.",[["h","Solenoid coil open"],["m","Short to ground"]],["ABS warning light on","ESC/stability control deactivated","Possible reduced brake assist"],["hard",[400,1600]],"l"],"C0401":["Traction Control Switch Circuit","The TCS on/off switch reports an implausible state.",[["h","Switch failed"],["m","Wiring shorted"]],["ABS warning light on","ESC/stability control deactivated","Possible reduced brake assist"],["easy",[30,200]],"l"],"C0402":["Traction Control Lamp Circuit","The TCS indicator lamp control circuit is shorted or open.",[["m","Indicator bulb/LED failed"],["m","Wiring shorted"]],["ABS warning light on","ESC/stability control deactivated","Possible reduced brake assist"],["easy",[40,350]],"l"],"C0405":["Traction Control Active Too Long","TCS regulation has been continuously active longer than allowed, suggesting persistent low-friction conditions or a sensor fault.",[["m","Persistent low-friction surface"],["m","Wheel speed sensor drift"]],["ABS warning light on","ESC/stability control deactivated","Possible reduced brake assist"],["medium",[80,600]],"l"],"C0410":["Adaptive Cruise Control Sensor Circuit Malfunction","The adaptive cruise control module has detected a fault in its forward-looking radar or lidar sensor circuit. ACC and forward collision warning are unavailable while the fault is active.",[["h","Radar sensor blocked by snow, ice or dirt"],["m","Sensor misaligned after front-end impact"],["m","Radar/lidar sensor failed"]],["ABS warning light on","ESC/stability control deactivated","Possible reduced brake assist"],["medium",[200,1500]],"l"],"C0420":["Adaptive Cruise Control Module Internal Performance","The adaptive cruise control module has reported an internal performance fault — for example self-test failure, supply voltage out of range or invalid configuration. ACC is disabled.",[["h","ACC module internal fault"],["m","Supply voltage out of range"],["l","Module configuration invalid after part exchange"]],["ABS warning light on","ESC/stability control deactivated","Possible reduced brake assist"],["hard",[300,1800]],"l"],"C0440":["Steering Wheel Position Sensor Circuit","The steering angle sensor reports an electrical fault. ESC and lane keeping assistance functions are typically disabled.",[["h","Steering angle sensor failed"],["m","Clock spring damaged"]],["ABS warning light on","ESC/stability control deactivated","Possible reduced brake assist"],["medium",[200,900]],"l"],"C0445":["Steering Wheel Position Sensor Calibration","The steering angle sensor has not been calibrated after a service operation, or the calibration value is implausible.",[["h","Calibration not performed after alignment/repair"]],["ABS warning light on","ESC/stability control deactivated","Possible reduced brake assist"],["easy",[40,200]],"l"],"C0450":["Rear Wheel Steering Position Sensor Circuit","On vehicles with active rear wheel steering, the rear position sensor reports an electrical fault. The system disables rear steering.",[["h","Sensor failed"],["m","Actuator harness chafe"]],["ABS warning light on","ESC/stability control deactivated","Possible reduced brake assist"],["hard",[400,2000]],"l"],"C0455":["Steering Wheel Position Sensor Circuit","The chassis or stability control module has detected a fault in the steering wheel position sensor circuit. ESP and lane assist systems require an accurate steering angle and may be deactivated.",[["h","Steering angle sensor failed"],["m","Sensor not calibrated after alignment"],["l","Wiring or connector fault"]],["ABS warning light on","ESC/stability control deactivated","Possible reduced brake assist"],["medium",[150,800]],"l"],"C0460":["Steering Position Signal Implausible","Steering angle signal is implausible compared with yaw rate, lateral acceleration and wheel speeds.",[["m","Wheel alignment off after impact"],["m","Sensor drift"]],["ABS warning light on","ESC/stability control deactivated","Possible reduced brake assist"],["medium",[80,500]],"l"],"C0496":["Yaw Rate Sensor Circuit","The yaw rate sensor reports an electrical fault. ESC is disabled while the fault is active.",[["h","Yaw rate sensor failed"],["m","Wiring shorted"]],["ABS warning light on","ESC/stability control deactivated","Possible reduced brake assist"],["medium",[200,800]],"l"],"C0497":["Yaw Rate Sensor Range/Performance","The yaw rate sensor signal is implausible relative to steering angle and lateral acceleration.",[["h","Sensor drift with age"],["m","Sensor mounting loose"],["l","Sensor element aged beyond calibration window"]],["ABS warning light on","ESC/stability control deactivated","Possible reduced brake assist"],["medium",[200,800]],"l"],"C0498":["Lateral Acceleration Sensor Circuit","The lateral acceleration sensor reports an electrical fault.",[["h","Sensor failed"],["m","Wiring open"]],["ABS warning light on","ESC/stability control deactivated","Possible reduced brake assist"],["medium",[200,800]],"l"],"C0499":["Lateral Acceleration Sensor Range/Performance","The lateral acceleration sensor signal is outside the plausibility range.",[["h","Sensor drift"],["m","Sensor mounting loose"],["l","Sensor element aged beyond calibration window"]],["ABS warning light on","ESC/stability control deactivated","Possible reduced brake assist"],["medium",[200,800]],"l"],"C0500":["Anti-lock Brake System Disabled","A general status code indicating that ABS function has been disabled by the brake control module. It is set in addition to the underlying root-cause code that disabled ABS.",[["h","Underlying ABS fault disables function"],["m","Communication bus fault to ABS module"]],["ABS warning light on","ESC/stability control deactivated","Possible reduced brake assist"],["medium",[50,1200]],"l"],"C0501":["ESC Active Performance","ESC interventions occur but do not produce the expected vehicl