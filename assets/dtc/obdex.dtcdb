,"The ABS control module detects an electrical fault in the pump motor circuit. Without a working pump, the system cannot build hydraulic pressure for ABS or stability control interventions and disables those functions.",[["h","Pump motor seized after long inactivity"],["m","Pump motor relay welded or open"],["m","Power supply connection corroded"]],["ABS warning light on","ESC/stability control deactivated","Possible reduced brake assist"],["hard",[300,1400]],"c"],"C0024":["Brake Pedal Feedback Pressure Solenoid Circuit","Fault on brake pedal feedback pressure solenoid — used in brake-by-wire systems to provide pedal feel.",[["h","Solenoid failed or wiring fault"]],["ABS warning light on","ESC/stability control deactivated","Possible reduced brake assist"],["hard",[300,2000]],"l"],"C0025":["ABS Pump Motor Stalled","The pump motor draws current but does not rotate. Self-test detects a stalled rotor and disables ABS and stability control.",[["h","Pump mechanically seized"],["m","Contaminated brake fluid blocking pump"]],["ABS warning light on","ESC/stability control deactivated","Possible reduced brake assist"],["hard",[400,1600]],"l"],"C0031":["Left Front Wheel Speed Sensor Circuit Low","Voltage on the left front wheel speed sensor circuit is below the expected range. The fault is typically caused by a short to ground or an open in the supply line.",[["h","Sensor wiring shorted to ground"],["m","Sensor coil open internally"],["l","Connector pins corroded - high contact resistance"]],["ABS warning light on","ESC/stability control deactivated","Possible reduced brake assist"],["medium",[80,350]],"c"],"C0032":["Left Front Wheel Speed Sensor Circuit High","Voltage on the left front wheel speed sensor circuit is above the expected range, typically due to a short to battery voltage.",[["h","Sensor wiring shorted to B+"],["m","Connector water ingress"],["l","Connector pins corroded - high contact resistance"]],["ABS warning light on","ESC/stability control deactivated","Possible reduced brake assist"],["medium",[80,350]],"c"],"C0034":["Left Front Wheel Speed Sensor No Signal","No pulses are received from the left front wheel speed sensor while other wheels report motion. The fault disables ABS and stability control.",[["h","Sensor internally failed"],["m","Wiring open at suspension flex"]],["ABS warning light on","ESC/stability control deactivated","Possible reduced brake assist"],["medium",[80,400]],"c"],"C0035":["Left Front Wheel Speed Sensor Circuit Malfunction","The ABS control module has detected a fault in the left front wheel speed sensor circuit. Loss of wheel speed information disables ABS and stability control, and a separate ABS warning lamp is illuminated.",[["h","Wheel speed sensor failed"],["m","Tone ring (reluctor) damaged or contaminated with debris"],["m","Wiring break or chafe at wheel arch"],["l","Wheel hub bearing with integrated sensor ring failed"]],["ABS warning light on","ESC/stability control deactivated","Possible reduced brake assist"],["medium",[80,400]],"c"],"C0037":["Left Rear Wheel Speed Sensor","Generic fault on left rear wheel speed sensor. Wheel-speed signals feed ABS, ESC, traction control, transmission and odometer — a single dropped signal disables all of these safety functions until repaired.",[["h","Sensor failed"]],["ABS warning light on","ESC/stability control deactivated","Possible reduced brake assist"],["medium",[80,500]],"c"],"C0038":["Left Rear Wheel Speed Sensor Supply","Fault on left rear wheel speed sensor supply circuit. Wheel-speed signals feed ABS, ESC, traction control, transmission and odometer — a single dropped signal disables all of these safety functions until repaired.",[["h","Supply wiring fault"]],["ABS warning light on","ESC/stability control deactivated","Possible reduced brake assist"],["medium",[60,400]],"c"],"C0039":["Right Rear Tone Wheel","Fault detected on right rear tone wheel (pulse ring).",[["h","Tone ring damaged or contaminated"]],["ABS warning light on","ESC/stability control deactivated","Possible reduced brake assist"],["medium",[100,800]],"c"],"C003A":["Right Rear Wheel Speed Sensor","Generic fault on right rear wheel speed sensor. Wheel-speed signals feed ABS, ESC, traction control, transmission and odometer — a single dropped signal disables all of these safety functions until repaired.",[["h","Sensor failed"]],["ABS warning light on","ESC/stability control deactivated","Possible reduced brake assist"],["medium",[80,500]],"c"],"C003B":["Right Rear Wheel Speed Sensor Supply","Fault on right rear wheel speed sensor supply circuit. Wheel-speed signals feed ABS, ESC, traction control, transmission and odometer — a single dropped signal disables all of these safety functions until repaired.",[["h","Supply wiring fault"]],["ABS warning light on","ESC/stability control deactivated","Possible reduced brake assist"],["medium",[60,400]],"c"],"C003C":["Rear Tone Wheel","Fault on shared rear tone wheel (single rear sensor on solid axle).",[["h","Tone ring damaged or contaminated"]],["ABS warning light on","ESC/stability control deactivated","Possible reduced brake assist"],["medium",[100,800]],"c"],"C003D":["Rear Wheel Speed Sensor","Generic fault on shared rear wheel speed sensor. Wheel-speed signals feed ABS, ESC, traction control, transmission and odometer — a single dropped signal disables all of these safety functions until repaired.",[["h","Sensor failed"]],["ABS warning light on","ESC/stability control deactivated","Possible reduced brake assist"],["medium",[80,500]],"c"],"C003E":["Rear Wheel Speed Sensor Supply","Fault on rear wheel speed sensor supply circuit. Wheel-speed signals feed ABS, ESC, traction control, transmission and odometer — a single dropped signal disables all of these safety functions until repaired.",[["h","Supply wiring fault"]],["ABS warning light on","ESC/stability control deactivated","Possible reduced brake assist"],["medium",[60,400]],"c"],"C003F":["Wheel Speed Sensors Rotation Direction Correla