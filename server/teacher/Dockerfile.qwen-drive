# Qwen-Drive-1.0 (QwenLM/Qwen-Drive-1.0), versiones del requirements.txt oficial.
# Sin flash-attn: atención SDPA de PyTorch (sin compilar, misma salida).
FROM nvidia/cuda:12.8.0-devel-ubuntu24.04
ENV DEBIAN_FRONTEND=noninteractive PIP_BREAK_SYSTEM_PACKAGES=1 PIP_NO_CACHE_DIR=1
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-pip python3-dev git \
      libgl1 libglib2.0-0 && rm -rf /var/lib/apt/lists/*
RUN pip install torch==2.8.0 torchvision==0.23.0 --index-url https://download.pytorch.org/whl/cu128
RUN pip install transformers==5.14.1 accelerate==1.12.0 safetensors==0.8.0 numpy==2.2.6 pillow==12.0.0 \
      opencv-python-headless matplotlib==3.10.7 tqdm pyarrow flash-linear-attention==0.5.1
# causal-conv1d trae ruedas precompiladas para torch 2.8 / cu12; si no, compila con nvcc.
RUN pip install --no-build-isolation causal-conv1d==1.6.2.post1 || echo "causal-conv1d no disponible: ruta PyTorch"
COPY src/qwen-drive /opt/qwen-drive
RUN pip install --no-deps -e /opt/qwen-drive
WORKDIR /work
